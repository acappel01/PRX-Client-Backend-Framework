APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8+ in any real deployment. The schema uses JSON columns.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prx_backend
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis, not database: Horizon supervises the queues and workflow chains run on
# them. A worker MUST be running or automation enqueues silently and never fires.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── RUNNING MORE THAN ONE INSTALL ON ONE HOST ────────────────────────────
# Every value below must differ from every other install sharing this Redis
# and this host. Prefix namespacing alone is NOT enough: Horizon and Reverb do
# not fully respect it, so two installs left on the defaults share a queue and
# a websocket server, and the symptoms are baffling rather than loud — jobs
# picked up by the wrong app, clients receiving another app's events.
#
# A CLONED .env IS THE USUAL CAUSE. It carries the previous install's Reverb
# credentials byte for byte, which silently joins the two apps' channels.
# Generate fresh ones per install; never copy them.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=prx_backend_database_
HORIZON_PREFIX=prx_backend_horizon:
SESSION_COOKIE=prx_backend_session

# How long Redis waits before deciding a reserved job was abandoned. Must stay
# ABOVE the matching worker timeout in config/horizon.php — cross them and a
# long workflow chain is marked failed without running while another worker
# quietly completes it. A test pins the relationship.
# WORKFLOWS_QUEUE_RETRY_AFTER=300

# ── BROADCASTING (optional) ──────────────────────────────────────────────
# Bind Reverb to loopback and reverse-proxy wss://…/app to it.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The first admin account, created by AdminUserSeeder on `migrate --seed`.
# Remove these once the account exists.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Decoupled frontend on-demand revalidation (optional). CMS writes POST the
# affected cache tags here. Secret must match the frontend's REVALIDATE_SECRET.
CMS_FRONTEND_REVALIDATE_URL=
CMS_FRONTEND_REVALIDATE_SECRET=
CMS_FRONTEND_REVALIDATE_TIMEOUT=5

# Public origin of the decoupled frontend, for links in outbound email.
# NOT the revalidate URL, which points at 127.0.0.1 on a co-hosted install and
# would email recipients a localhost link.
CMS_FRONTEND_URL=

# Reverse proxies whose X-Forwarded-* headers are believed. Empty trusts
# nothing (correct when directly exposed). This decides what lands in
# lead_consents.ip_address — the record of who consented — so it is not
# cosmetic. Behind a load balancer with no fixed address (AWS ALB), use
# REMOTE_ADDR, which trusts exactly the connecting peer and is safe because the
# target security group admits only the balancer.
#
# Do NOT use "*": it trusts 0.0.0.0/0, which makes Symfony fall back to the
# LEFTMOST X-Forwarded-For entry — the part the visitor writes — so any
# anonymous caller can forge the recorded IP. See config/trustedproxy.php.
TRUSTED_PROXIES=
